# --- Varaaha product API (server/) ---
PORT=5001
NODE_ENV=development

# Supabase Postgres - use the TRANSACTION-mode pooler (port 6543), not the
# direct/session connection, since Vercel serverless functions open many
# short-lived connections and the transaction pooler is built for that.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=change_me

# Product catalog admin login. Uses bcryptjs (pure JS, no native bindings -
# argon2's native build doesn't run on Vercel's serverless Linux runtime).
# Generate the hash with:
#   node -e "require('bcryptjs').hash('yourpassword', 10).then(console.log)"
PRODUCT_ADMIN_EMAIL=admin@example.com
PRODUCT_ADMIN_PASSWORD_HASH=change_me

# Comma-separated list of allowed origins for the storefront.
CORS_ORIGINS=http://localhost:5183,https://varaaha-nuts.vercel.app

# Where the STOREFRONT (not this API) is reachable - product images live in
# /public/products and are served from there.
PUBLIC_BASE_URL=http://localhost:5183

# Supabase Storage - used for the admin panel's "Upload from device" image
# uploads (banner/product/category photos). Get these from the Supabase
# dashboard: Settings -> API Keys. SERVICE_ROLE_KEY is the secret key
# (full access, bypasses RLS) - never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change_me
